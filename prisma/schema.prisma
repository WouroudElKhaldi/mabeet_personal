// SE-NEXT Stays: direct bookings for guesthouses.
// Every tenant-owned table carries businessId. Repositories always filter by it.
// The no-overlap guarantee lives in a raw SQL migration (see prisma/migrations/*_occupancy_no_overlap).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity (Better Auth tables + platform role) ----------

enum PlatformRole {
  USER
  SUPER_ADMIN
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  phone         String?
  locale        String       @default("en")
  platformRole  PlatformRole @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions           Session[]
  accounts           Account[]
  memberships        Membership[]
  bookings           Booking[]           @relation("GuestBookings")
  favorites          Favorite[]
  reviews            Review[]
  activities         ActivityLog[]
  apiKeys            ApiKey[]
  sessionBookings    SessionBooking[]    @relation("GuestSessionBookings")
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  pushSubscriptions  PushSubscription[]
  hostProfile        HostProfile?
}

/// A host's own details, kept for every person who owns a business. Guests only see them when the host turns
/// `showOnListings` on; platform admins always can.
model HostProfile {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String?
  bio            String?
  phone          String?
  whatsapp       String?
  city           String?
  /// Languages the host speaks, as codes from src/config/listing.ts.
  languages      String[]
  hostingSince   Int?
  showOnListings Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Session {
  id            String   @id
  expiresAt     DateTime
  token         String   @unique
  ipAddress     String?
  userAgent     String?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The workspace picked while connecting an AI app over OAuth; its tokens act for this business.
  mcpBusinessId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------- Platform ----------

// One row (id "site") of settings the super admin controls for the whole website, such as the colour palette.
// Visitors only choose light or dark mode and their language.
model SiteSetting {
  id          String   @id @default("site")
  palette     String   @default("cedar")
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ---------- Tenancy and dynamic roles ----------

/// What a business pays for. Limits live in src/config/plans.ts; Stripe webhooks keep it in sync.
enum Plan {
  FREE
  PRO
  BUSINESS
}

/// How a guest's request becomes a booking: the host decides, or it is confirmed at once.
enum BookingMode {
  REQUEST
  INSTANT
}

/// Where the guest pays: to the host directly (cash, Whish, OMT, bank), or online through Mabeet.
enum PaymentCollection {
  AT_PLACE
  ONLINE
}

/// What an online payment covers: the deposit (the rest is paid at the place) or the whole stay.
enum OnlineAmount {
  DEPOSIT
  FULL
}

/// How much of an online payment a guest gets back when they cancel. Hosts cancelling always refund in full.
enum RefundPolicy {
  FLEXIBLE
  MODERATE
  STRICT
  NON_REFUNDABLE
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

model Business {
  id                   String            @id @default(cuid())
  name                 String
  slug                 String            @unique
  description          String?
  area                 String?
  address              String?
  latitude             Float?
  longitude            Float?
  phone                String?
  whatsapp             String?
  timezone             String            @default("Asia/Beirut")
  currency             String            @default("USD")
  lbpRate              Int?
  commissionRateBps    Int               @default(1500) // 15.00%, the platform commission a direct booking saves
  depositPercent       Int               @default(30)
  holdHours            Int               @default(24)
  depositInstructions  String?
  checkInTime          String            @default("14:00")
  checkOutTime         String            @default("11:00")
  houseRules           String?
  cancellationPolicy   String?
  bookingMode          BookingMode       @default(REQUEST)
  paymentCollection    PaymentCollection @default(AT_PLACE)
  onlineAmount         OnlineAmount      @default(DEPOSIT)
  refundPolicy         RefundPolicy      @default(FLEXIBLE)
  listedPublicly       Boolean           @default(false)
  // Fixed keys from src/config/listing.ts: tags for search filters, accessibility for "Things to know".
  tags                 String[]
  accessibility        String[]
  minGuestAge          Int?
  status               BusinessStatus    @default(ACTIVE)
  plan                 Plan              @default(FREE)
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  /// When the paid plan renews, or ends if it was cancelled.
  planRenewsAt         DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  roles           Role[]
  memberships     Membership[]
  rooms           Room[]
  bookings        Booking[]
  occupancies     Occupancy[]
  feeds           CalendarFeed[]
  payments        Payment[]
  reviews         Review[]
  categories      BusinessCategory[]
  favorites       Favorite[]
  apiKeys         ApiKey[]
  mcpAuditLogs    McpAuditLog[]
  activities      ActivityLog[]
  photos          Photo[]
  offerings       Offering[]
  sessions        OfferingSession[]
  sessionBookings SessionBooking[]
  images          StoredImage[]
  refunds         Refund[]
  payouts         Payout[]
  planPayments    PlanPayment[]
}

// A role is created by an owner or manager and holds a list of permission keys
// (see src/server/auth/permissions.ts). isOwner marks the undeletable owner role, which holds every permission.
model Role {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions String[]
  isOwner     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]

  @@unique([businessId, name])
  @@index([businessId])
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

model Membership {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  apiKeys    ApiKey[]

  @@unique([userId, businessId])
  @@index([businessId])
}

// ---------- Catalogue ----------

model Room {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  capacity      Int      @default(2)
  bedrooms      Int      @default(1)
  beds          Int      @default(1)
  bathrooms     Int      @default(1)
  baseRateCents Int
  minNights     Int      @default(1)
  amenities     String[]
  exportToken   String   @unique
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rateOverrides RateOverride[]
  feeds         CalendarFeed[]
  bookings      Booking[]
  occupancies   Occupancy[]
  reviews       Review[]
  photos        Photo[]

  @@index([businessId])
}

model Photo {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  offeringId String?
  offering   Offering? @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([businessId])
}

model RateOverride {
  id         String   @id @default(cuid())
  businessId String
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  rateCents  Int

  @@unique([roomId, date])
  @@index([businessId])
}

enum ListingKind {
  HOME
  EXPERIENCE
  SERVICE
}

/// Categories belong to one listing type: homes, experiences or services each have their own list.
model Category {
  slug       String             @id
  kind       ListingKind        @default(HOME)
  nameEn     String
  nameAr     String
  icon       String
  position   Int                @default(0)
  businesses BusinessCategory[]
  offerings  Offering[]
}

model BusinessCategory {
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categorySlug String
  category     Category @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)

  @@id([businessId, categorySlug])
}

// ---------- Calendar ----------

enum FeedSource {
  AIRBNB
  BOOKING
  KAZDERNI
  OTHER
}

model CalendarFeed {
  id           String      @id @default(cuid())
  businessId   String
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roomId       String
  room         Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url          String
  source       FeedSource
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime    @default(now())
  occupancies  Occupancy[]

  @@index([businessId])
  @@index([roomId])
}

enum BookingStatus {
  HELD
  /// Accepted (or booked instantly) and waiting for the guest's online payment; the nights stay taken.
  AWAITING_PAYMENT
  CONFIRMED
  DECLINED
  EXPIRED
  CANCELLED
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roomId         String
  room           Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guestUserId    String?
  guestUser      User?         @relation("GuestBookings", fields: [guestUserId], references: [id], onDelete: SetNull)
  guestName      String
  guestPhone     String
  guestEmail     String?
  guestCount     Int
  guestNote      String?
  /// The language the guest booked in; their emails are written in it.
  locale         String        @default("en")
  checkIn        DateTime      @db.Date
  checkOut       DateTime      @db.Date
  totalCents     Int
  depositCents   Int
  currency       String
  /// What the guest pays online through Mabeet; null when they pay the host directly. Fixed when booked.
  onlineDueCents Int?
  /// The refund policy the guest agreed to when booking.
  refundPolicy   RefundPolicy  @default(FLEXIBLE)
  status         BookingStatus @default(HELD)
  publicToken    String        @unique
  holdExpiresAt  DateTime?
  decidedById    String?
  decidedAt      DateTime?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  occupancy Occupancy?
  payments  Payment[]
  review    Review?

  @@index([businessId, status])
  @@index([roomId])
  @@index([guestUserId])
}

enum OccupancyKind {
  DIRECT
  MANUAL
  IMPORTED
}

// One row per taken night range, whatever the source. The exclusion constraint lives here.
model Occupancy {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roomId      String
  room        Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  checkIn     DateTime      @db.Date
  checkOut    DateTime      @db.Date
  kind        OccupancyKind
  active      Boolean       @default(true)
  source      FeedSource?
  note        String?
  conflict    Boolean       @default(false)
  bookingId   String?       @unique
  booking     Booking?      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  feedId      String?
  feed        CalendarFeed? @relation(fields: [feedId], references: [id], onDelete: Cascade)
  externalUid String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([feedId, externalUid])
  @@index([businessId])
  @@index([roomId, active])
}

// ---------- Money ----------

enum PaymentMethod {
  CASH
  WHISH
  OMT
  BANK_TRANSFER
  STRIPE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model Payment {
  id                String          @id @default(cuid())
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Exactly one of bookingId / sessionBookingId is set (CHECK constraint in the migration).
  bookingId         String?
  booking           Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sessionBookingId  String?
  sessionBooking    SessionBooking? @relation(fields: [sessionBookingId], references: [id], onDelete: Cascade)
  amountCents       Int
  currency          String
  method            PaymentMethod
  status            PaymentStatus   @default(PAID)
  providerRef       String?         @unique
  note              String?
  recordedById      String?
  /// Paid online through Mabeet's Whish or Stripe account, so Mabeet owes it to the host.
  online            Boolean         @default(false)
  /// Stripe's payment intent, needed to refund a card payment.
  providerPaymentId String?
  checkoutUrl       String?
  paidAt            DateTime?
  refundedCents     Int             @default(0)
  createdAt         DateTime        @default(now())
  refunds           Refund[]

  @@index([businessId])
}

enum RefundStatus {
  /// Owed to the guest; Mabeet sends it by hand (a partial Whish refund) and marks it done.
  PENDING
  DONE
}

/// Money given back to a guest from an online payment. Reduces what Mabeet owes the host.
model Refund {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  paymentId   String
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String
  status      RefundStatus
  reason      String
  providerRef String?
  doneAt      DateTime?
  doneById    String?
  createdAt   DateTime     @default(now())

  @@index([businessId])
  @@index([status])
}

enum PayoutMethod {
  BANK_TRANSFER
  WHISH
}

enum PayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

/// A host asks Mabeet to send them what it collected online for them; an admin pays it and marks it.
model Payout {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amountCents   Int
  currency      String
  method        PayoutMethod
  accountName   String
  bankName      String?
  iban          String?
  whishPhone    String?
  status        PayoutStatus @default(REQUESTED)
  requestedById String
  reference     String?
  adminNote     String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([businessId])
  @@index([status])
}

/// A host paying for a plan: Stripe invoices and Whish monthly payments. This is Mabeet's revenue.
model PlanPayment {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        Plan
  amountCents Int
  currency    String
  method      PaymentMethod
  status      PaymentStatus
  providerRef String        @unique
  checkoutUrl String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([businessId])
  @@index([status, paidAt])
}

/// The simulated Whish Pay server's own records (WHISH_MODE=simulator). Not used with real Whish keys.
model WhishSandboxPayment {
  externalId         String   @id
  code               String   @unique
  amount             String
  currency           String
  invoice            String?
  successCallbackUrl String
  failureCallbackUrl String
  successRedirectUrl String
  failureRedirectUrl String
  /// pending, success, failed or refunded, as Whish reports collectStatus.
  status             String   @default("pending")
  payerPhone         String?
  createdAt          DateTime @default(now())
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  payload    Json
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
}

// ---------- Guests: favourites, reviews, activity ----------

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model Review {
  id               String          @id @default(cuid())
  businessId       String
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Either a stay (room + booking) or an experience or service (offering + session booking);
  // CHECK review_one_booking keeps exactly one pair.
  roomId           String?
  room             Room?           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookingId        String?         @unique
  booking          Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  offeringId       String?
  offering         Offering?       @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  sessionBookingId String?         @unique
  sessionBooking   SessionBooking? @relation(fields: [sessionBookingId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  rating           Int
  cleanliness      Int?
  location         Int?
  value            Int?
  comment          String
  ownerReply       String?
  status           ReviewStatus    @default(PUBLISHED)
  hiddenReason     String?
  createdAt        DateTime        @default(now())

  @@index([businessId, status])
  @@index([offeringId, status])
}

model ActivityLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  action     String
  entity     String
  entityId   String?
  meta       Json?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([businessId, createdAt])
}

// ---------- MCP and AI ----------

// A key belongs to one membership, so an AI using it sees exactly what that member is allowed to see.
model ApiKey {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  name         String
  prefix       String
  hash         String     @unique
  canWrite     Boolean    @default(false)
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([businessId])
}

model McpAuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  apiKeyId   String?
  userId     String?
  channel    String // mcp | chat
  tool       String
  outcome    String
  latencyMs  Int
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// ---------- Experiences and services ----------

enum PriceUnit {
  PER_PERSON
  PER_GROUP
}

enum ActivityLevel {
  LIGHT
  MODERATE
  CHALLENGING
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Something bookable by the session rather than by the night: a hike, a wine tasting, a transfer, a private chef.
model Offering {
  id                String         @id @default(cuid())
  businessId        String
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind              ListingKind
  slug              String         @unique
  title             String
  description       String?
  categorySlug      String?
  category          Category?      @relation(fields: [categorySlug], references: [slug], onDelete: SetNull)
  area              String?
  meetingPoint      String?
  latitude          Float?
  longitude         Float?
  durationMinutes   Int
  priceCents        Int
  priceUnit         PriceUnit      @default(PER_PERSON)
  maxGuests         Int            @default(10)
  minAge            Int?
  activityLevel     ActivityLevel?
  skillLevel        SkillLevel?
  included          String[]
  notIncluded       String[]
  accessibility     String[]
  languages         String[]
  tags              String[]
  cancellationHours Int            @default(24)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  photos   Photo[]
  sessions OfferingSession[]
  bookings SessionBooking[]
  reviews  Review[]

  @@index([businessId])
  @@index([kind, active])
}

/// One dated run of an offering with a number of seats. The seat guarantee is a trigger in the migration.
model OfferingSession {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  offeringId String
  offering   Offering         @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  capacity   Int
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  bookings   SessionBooking[]

  @@index([offeringId, startsAt])
  @@index([businessId])
}

model SessionBooking {
  id             String          @id @default(cuid())
  reference      String          @unique
  publicToken    String          @unique
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  offeringId     String
  offering       Offering        @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  sessionId      String
  session        OfferingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  guestUserId    String?
  guestUser      User?           @relation("GuestSessionBookings", fields: [guestUserId], references: [id], onDelete: SetNull)
  guestName      String
  guestPhone     String
  guestEmail     String?
  guestNote      String?
  /// The language the guest booked in; their emails are written in it.
  locale         String          @default("en")
  seats          Int
  totalCents     Int
  depositCents   Int
  currency       String
  /// What the guest pays online through Mabeet; null when they pay the host directly. Fixed when booked.
  onlineDueCents Int?
  /// The refund policy the guest agreed to when booking.
  refundPolicy   RefundPolicy    @default(FLEXIBLE)
  status         BookingStatus   @default(HELD)
  holdExpiresAt  DateTime?
  decidedById    String?
  decidedAt      DateTime?
  cancelReason   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  payments       Payment[]
  review         Review?

  @@index([businessId, status])
  @@index([sessionId])
  @@index([guestUserId])
}

/// Uploaded photo bytes, served from /api/images/{id}. Kept in Postgres so the pilot needs no extra storage service.
model StoredImage {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mimeType   String
  bytes      Bytes
  size       Int
  createdAt  DateTime @default(now())

  @@index([businessId])
}

/// One rate-limit window per key (e.g. "booking:ip:1.2.3.4"). Shared by every server instance.
model RateLimitWindow {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Tokens and cost of one assistant answer (all its model calls), for the monthly AI budget.
model AiUsage {
  id               String   @id @default(cuid())
  /// "concierge" (guests) or "team" (the dashboard assistant).
  surface          String
  businessId       String?
  promptTokens     Int
  completionTokens Int
  /// US dollars × 1,000,000, so tiny costs stay exact integers.
  costMicroUsd     Int
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// ---------- OAuth for AI apps (Better Auth jwt + @better-auth/oauth-provider) ----------
// Field names and types follow the plugins' own schema definitions; do not rename them.

/// Signing keys for access tokens (jwt plugin).
model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?
}

/// An AI app (MCP client) that registered itself to connect.
model OauthClient {
  id                               String    @id
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]  @default([])
  userId                           String?
  user                             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         Json?

  resources     OauthClientResource[]
  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@index([userId])
}

/// An API that tokens can be issued for: here, the host MCP server.
model OauthResource {
  id                            String    @id
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?      @default(1)
  metadata                      Json?

  clients OauthClientResource[]
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
}

model OauthRefreshToken {
  id                      String      @id
  token                   String      @unique
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
}

model OauthAccessToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
}

/// What a person allowed an AI app to do, per workspace (referenceId is the business id).
model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
}

/// Each private_key_jwt assertion id, so it can be used only once.
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime
}

/// A phone or browser that receives push notifications. It follows either a signed-in person (every
/// notification they would get by email) or, for guests without an account, one booking by its private link.
model PushSubscription {
  id           String   @id @default(cuid())
  endpoint     String
  p256dh       String
  auth         String
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingToken String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([bookingToken])
  @@index([endpoint])
}
