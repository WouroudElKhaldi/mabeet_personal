# Local database started by `pnpm db:start` (stored in .pgdata). Any password works; it is set on first start.
DATABASE_URL="postgresql://postgres:choose-a-password@localhost:5433/se_next_stays"
# Separate database for integration tests (wiped by the tests).
TEST_DATABASE_URL="postgresql://postgres:choose-a-password@localhost:5433/se_next_stays_test"
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
CRON_SECRET="generate-a-long-random-string"
# "queue" puts AI work, notices and scheduled jobs on Postgres queues for the worker, as in production.
# `pnpm dev` starts the website and the worker together. Use "inline" (no worker: everything runs in the website)
# only with `pnpm dev:web`. Tests always run inline.
JOBS_MODE="queue"
# In "queue" mode, AI work expected to take longer than this many seconds goes to the worker. 0 queues it all.
JOBS_SYNC_LIMIT_SECONDS="5"
DEEPSEEK_API_KEY=""
# Monthly AI spend cap in US dollars (empty = the $50 default). Prices per million tokens default to DeepSeek's list price.
AI_MONTHLY_BUDGET_USD="50"
# AI_INPUT_USD_PER_M="0.28"
# AI_OUTPUT_USD_PER_M="0.42"
# Email (https://resend.com). Leave the key empty to log emails instead of sending them.
# onboarding@resend.dev only delivers to your own Resend account email; verify a domain to send to anyone.
RESEND_API_KEY=""
EMAIL_FROM="Mabeet <onboarding@resend.dev>"
# Stripe test mode (dashboard.stripe.com/test/apikeys). Create two monthly prices (Pro, Business) and paste their ids.
# Webhook: stripe listen --forward-to localhost:3000/api/webhooks/stripe, then paste the whsec_ secret it prints.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""
# Whish Pay (Mabeet's Whish account). "simulator" needs no keys: a stand-in Whish payment page runs inside the app
# (test phone 96170123456, code 111111). With keys from Whish, set "sandbox" (or "production") and fill the rest.
WHISH_MODE="simulator"
WHISH_CHANNEL=""
WHISH_SECRET=""
WHISH_WEBSITE_URL=""
# Push notifications to phones and browsers. Run `pnpm push:keys` and paste both lines. Empty = push turned off.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
